#[
    Finds the start below one million with the longest Collatz chain.
]#

function chain_length(integer64 start) returns integer64
    variable integer64 value = start
    variable integer64 steps = 1
    while value != 1
        if value % 2 == 0
            value = value / 2
        else
            value = value * 3 + 1
        steps = steps + 1
    return steps

function main()
    variable integer64 longest = 0
    variable integer64 best_start = 0
    for start in range(1, 1_000_000)
        constant steps = chain_length(start)
        if steps > longest
            longest = steps
            best_start = start
    print("{best_start} {longest}")
