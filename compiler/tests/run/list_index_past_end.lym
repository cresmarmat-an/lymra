#[
    An index past the end of a list stops the program before anything is
    stored, and before the value to store is even computed. A list is as
    long as the elements pushed so far, whatever was reserved for it.
]#

function noted(string name, integer64 value) returns integer64
    print("{name}")
    return value

function fill(variable list[integer64] values, integer64 count)
    for position in range(0, count)
        values[position] = noted("stored", position)

function main()
    variable list[integer64] values = list()
    for _ in range(0, 3)
        push(variable values, 0)
    fill(variable values, 4)
