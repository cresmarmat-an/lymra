#[
    Converting between integer types. A conversion that can fail is checked
    when the program runs; one that cannot fail is a plain copy.
]#

function main()
    constant unsigned8 small = 200
    constant integer64 widened = to_integer64(small)
    print("widened {widened}")

    constant integer64 count = 1_000
    constant unsigned16 narrowed = to_unsigned16(count)
    print("narrowed {narrowed}")

    constant integer8 negative = -5
    constant integer32 signed_widened = to_integer32(negative)
    print("signed {signed_widened}")

    constant unsigned64 big = 4_000_000_000
    constant integer64 from_unsigned = to_integer64(big)
    constant unsigned32 fits = to_unsigned32(big)
    print("unsigned {from_unsigned} {fits}")

    constant total = widened + to_integer64(narrowed)
    print("total {total}")
    print("known {to_unsigned8(255)} {to_integer8(-128)}")
