#[
    A shift by a count known only when the program runs is checked then: a
    count outside the bits of the value stops the program.
]#

function shifted(integer64 value, integer64 count) returns integer64
    return shift_left(value, count)

function main()
    print("{shifted(1, 3)}")
    print("{shifted(1, 63)}")
    print("{shifted(1, 64)}")
